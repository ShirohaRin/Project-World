      "api_key": ""
    },
    "core": {
      "enabled": false,
      "limit": 100,
      "query": "large language model retrieval",
      "api_key": ""
    },
    "europe_pmc": {
      "enabled": false,
      "limit": 100,
      "query": "machine learning"
    },
    "arxiv": {
      "enabled": true,
      "limit": 50,
      "query": "cat:cs.AI OR cat:cs.LG"
    }
  }
