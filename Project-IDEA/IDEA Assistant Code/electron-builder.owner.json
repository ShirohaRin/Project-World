{
  "appId": "cn.programidea.owner",
  "productName": "IDEA",
  "directories": { "output": "../setup" },
  "artifactName": "SRHsetup.${ext}",
  "files": ["dist/**/*", "dist-electron/**/*"],
  "extraResources": [{ "from": "dist-electron/client-flavor.json", "to": "dist-electron/client-flavor.json" }],
  "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
  "nsis": { "perMachine": false, "oneClick": false, "allowToChangeInstallationDirectory": true },
  "linux": { "target": [{ "target": "dir", "arch": ["x64"] }], "category": "Development" }
}
