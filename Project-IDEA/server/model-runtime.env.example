# Private, gitignored LLM runtime configuration.
# Fill each selected model independently; do not commit real keys.

# GPT
GPT_LLM_PROVIDER=custom
GPT_LLM_MODEL=<gpt-model-id>
GPT_API_BASE_URL=https://<gpt-openai-compatible-endpoint>/v1
GPT_API_KEY=<gpt-api-key>

# DeepSeek V4 Flash
DEEPSEEK_LLM_PROVIDER=custom
DEEPSEEK_LLM_MODEL=<deepseek-v4-flash-model-id>
DEEPSEEK_API_BASE_URL=https://<deepseek-openai-compatible-endpoint>/v1
DEEPSEEK_API_KEY=<deepseek-api-key>
