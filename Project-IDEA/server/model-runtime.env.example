# Private, gitignored LLM runtime configuration.
# Copy this file to model-runtime.env and keep the real credentials out of Git.

# Platform backend -> standalone official-model gateway
OFFICIAL_GATEWAY_BASE_URL=http://127.0.0.1:8787/v1
OFFICIAL_GATEWAY_TOKEN=<generate-a-private-gateway-token>

# Model keys exposed by the platform API
GPT_TERRA_LLM_PROVIDER=official_gateway
GPT_TERRA_LLM_MODEL=gpt-5.6-terra
GPT_TERRA_API_BASE_URL=https://api.openai.com/v1
GPT_TERRA_API_KEY=<fill-your-gpt-terra-api-key-here>
GPT_SOL_LLM_PROVIDER=official_gateway
GPT_SOL_LLM_MODEL=gpt-5.6-sol
GPT_SOL_API_BASE_URL=https://api.openai.com/v1
GPT_SOL_API_KEY=<fill-your-gpt-sol-api-key-here>
DEEPSEEK_FLASH_LLM_PROVIDER=official_gateway
DEEPSEEK_FLASH_LLM_MODEL=deepseek-v4-flash
DEEPSEEK_FLASH_API_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_FLASH_API_KEY=<fill-your-deepseek-flash-api-key-here>
DEEPSEEK_PRO_LLM_PROVIDER=official_gateway
DEEPSEEK_PRO_LLM_MODEL=deepseek-v4-pro
DEEPSEEK_PRO_API_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_PRO_API_KEY=<fill-your-deepseek-pro-api-key-here>

# Standalone gateway listener
OFFICIAL_GATEWAY_HOST=127.0.0.1
OFFICIAL_GATEWAY_PORT=8787

# Official upstream configuration; only the gateway reads the API keys.
OFFICIAL_GPT_MODEL=gpt-5.6-terra
OFFICIAL_GPT_API_BASE_URL=https://api.openai.com/v1
OFFICIAL_GPT_API_KEY=<fill-your-gpt-api-key-here>
OFFICIAL_DEEPSEEK_MODEL=deepseek-v4-flash
OFFICIAL_DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
OFFICIAL_DEEPSEEK_API_KEY=<fill-your-deepseek-api-key-here>

# Optional direct fallback when OFFICIAL_GATEWAY_BASE_URL or its token is absent.
GPT_API_BASE_URL=https://api.openai.com/v1
GPT_API_KEY=<fill-your-gpt-api-key-here>
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=<fill-your-deepseek-api-key-here>
