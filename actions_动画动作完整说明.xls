ing"></Data></Cell></Row><Row><Cell><Data ss:Type="String">基础动作/动画定义</Data></Cell><Cell><Data ss:Type="String">GrabWall</Data></Cell><Cell><Data ss:Type="String">GrabWall</Data></Cell><Cell><Data ss:Type="String">抓住墙</Data></Cell><Cell><Data ss:Type="String">Stay</Data></Cell><Cell><Data ss:Type="String">停留/循环播放</Data></Cell><Cell><Data ss:Type="String">Wall</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row><Row><Cell><Data ss:Type="String">基础动作/动画定义</Data></Cell><Cell><Data ss:Type="String">ClimbWall</Data></Cell><Cell><Data ss:Type="String">ClimbWall</Data></Cell><Cell><Data ss:Type="String">沿墙攀爬</Data></Cell><Cell><Data ss:Type="String">Move</Data></Cell><Cell><Data ss:Type="String">播放动画并移动到目标</Data></Cell><Cell><Data ss:Type="String">Wall</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row><Row><Cell><Data ss:Type="String">基础动作/动画定义</Data></Cell><Cell><Data ss:Type="String">FallWithIe</Data></Cell><Cell><Data ss:Type="String">FallWithIe</Data></Cell><Cell><Data ss:Type="String">动作/流程节点</Data></Cell><Cell><Data ss:Type="String">Embedded</Data></Cell><Cell><Data ss:Type="String">调用 Java 内置动作类</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">Class=com.group_finity.mascot.action.FallWithIE; IeOffsetX=6; IeOffsetY=-58</Data></Cell></Row><Row><Cell><Data ss:Type="String">基础动作/动画定义</Data></Cell><Cell><Data ss:Type="String">WalkWithIe</Data></Cell><Cell><Data ss:Type="String">WalkWithIe</Data></Cell><Cell><Data ss:Type="String">抱着窗口行走</Data></Cell><Cell><Data ss:Type="String">Embedded</Data></Cell><Cell><Data ss:Type="String">调用 Java 内置动作类</Data></Cell><Cell><Data ss:Type="String">Floor</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">Class=com.group_finity.mascot.action.WalkWithIE; IeOffsetX=6; IeOffsetY=-58</Data></Cell></Row><Row><Cell><Data ss:Type="String">基础动作/动画定义</Data></Cell><Cell><Data ss:Type="String">RunWithIe</Data></Cell><Cell><Data ss:Type="String">RunWithIe</Data></Cell><Cell><Data ss:Type="String">抱着窗口奔跑</Data></Cell><Cell><Data ss:Type="String">Embedded</Data></Cell><Cell><Data ss:Type="String">调用 Java 内置动作类</Data></Cell><Cell><Data ss:Type="String">Floor</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">Class=com.group_finity.mascot.action.WalkWithIE; IeOffsetX=6; IeOffsetY=-58</Data></Cell></Row><Row><Cell><Data ss:Type="String">基础动作/动画定义</Data></Cell><Cell><Data ss:Type="String">ThrowIe</Data></Cell><Cell><Data ss:Type="String">ThrowIe</Data></Cell><Cell><Data ss:Type="String">抛出窗口</Data></Cell><Cell><Data ss:Type="String">Embedded</Data></Cell><Cell><Data ss:Type="String">调用 Java 内置动作类</Data></Cell><Cell><Data ss:Type="String">Floor</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">Class=com.group_finity.mascot.action.ThrowIE; InitialVX=32; InitialVY=-10; Gravity=0.5</Data></Cell></Row><Row><Cell><Data ss:Type="String">基础动作/动画定义</Data></Cell><Cell><Data ss:Type="String">Jumping</Data></Cell><Cell><Data ss:Type="String">Jumping</Data></Cell><Cell><Data ss:Type="String">跳跃</Data></Cell><Cell><Data ss:Type="String">Embedded</Data></Cell><Cell><Data ss:Type="String">调用 Java 内置动作类</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">Class=com.group_finity.mascot.action.Jump; VelocityParam=20</Data></Cell></Row><Row><Cell><Data ss:Type="String">基础动作/动画定义</Data></Cell><Cell><Data ss:Type="String">JumpGrabFace</Data></Cell><Cell><Data ss:Type="String">JumpGrabFace</Data></Cell><Cell><Data ss:Type="String">动作/流程节点</Data></Cell><Cell><Data ss:Type="String">Embedded</Data></Cell><Cell><Data ss:Type="String">调用 Java 内置动作类</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">Class=com.group_finity.mascot.action.Jump; VelocityParam=16; TargetX=${mascot.anchor.x}; TargetY=${Math.max(mascot.environment.activeIE.top+80, Math.min(mascot.anchor.y-24, mascot.environment.activeIE.bottom-10))}</Data></Cell></Row><Row><Cell><Data ss:Type="String">基础动作/动画定义</Data></Cell><Cell><Data ss:Type="String">FaceGlideUp</Data></Cell><Cell><Data ss:Type="String">FaceGlideUp</Data></Cell><Cell><Data ss:Type="String">沿窗口正面向上滑</Data></Cell><Cell><Data ss:Type="String">Embedded</Data></Cell><Cell><Data ss:Type="String">调用 Java 内置动作类</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">Class=com.group_finity.mascot.action.Jump; VelocityParam=2.4; TargetX=${mascot.anchor.x}; TargetY=${mascot.environment.activeIE.top + 50}</Data></Cell></Row><Row><Cell><Data ss:Type="String">基础动作/动画定义</Data></Cell><Cell><Data ss:Type="String">FaceGlideMid</Data></Cell><Cell><Data ss:Type="String">FaceGlideMid</Data></Cell><Cell><Data ss:Type="String">动作/流程节点</Data></Cell><Cell><Data ss:Type="String">Embedded</Data></Cell><Cell><Data ss:Type="String">调用 Java 内置动作类</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">Class=com.group_finity.mascot.action.Jump; VelocityParam=2.4; TargetX=${mascot.anchor.x}; TargetY=${Math.max(mascot.environment.activeIE.top+120, mascot.anchor.y - 100 - Math.random()*200)}</Data></Cell></Row><Row><Cell><Data ss:Type="String">基础动作/动画定义</Data></Cell><Cell><Data ss:Type="String">FaceGlideDown</Data></Cell><Cell><Data ss:Type="String">FaceGlideDown</Data></Cell><Cell><Data ss:Type="String">沿窗口正面向下滑</Data></Cell><Cell><Data ss:Type="String">Embedded</Data></Cell><Cell><Data ss:Type="String">调用 Java 内置动作类</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">Class=com.group_finity.mascot.action.Jump; VelocityParam=2.0; TargetX=${mascot.anchor.x}; TargetY=${mascot.environment.activeIE.top + 120 + Math.random()*160}</Data></Cell></Row><Row><Cell><Data ss:Type="String">基础动作/动画定义</Data></Cell><Cell><Data ss:Type="String">HopOntoTop</Data></Cell><Cell><Data ss:Type="String">HopOntoTop</Data></Cell><Cell><Data ss:Type="String">动作/流程节点</Data></Cell><Cell><Data ss:Type="String">Embedded</Data></Cell><Cell><Data ss:Type="String">调用 Java 内置动作类</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">Class=com.group_finity.mascot.action.Fall; RegistanceX=0.05; RegistanceY=0.05; Gravity=2; InitialVX=${mascot.environment.activeIE.leftBorder.isOn(mascot.anchor) ? 3 : (mascot.environment.activeIE.rightBorder.isOn(mascot.anchor) ? -3 : 0)}; InitialVY=-17</Data></Cell></Row><Row><Cell><Data ss:Type="String">基础动作/动画定义</Data></Cell><Cell><Data ss:Type="String">ClimbIEFace</Data></Cell><Cell><Data ss:Type="String">ClimbIEFace</Data></Cell><Cell><Data ss:Type="String">动作/流程节点</Data></Cell><Cell><Data ss:Type="String">Sequence</Data></Cell><Cell><Data ss:Type="String">按顺序执行子动作</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">false</Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row><Row><Cell><Data ss:Type="String">基础动作/动画定义</Data></Cell><Cell><Data ss:Type="String">ClimbIEFace</Data></Cell><Cell><Data ss:Type="String">(匿名 Action)</Data></Cell><Cell><Data ss:Type="String">动作/流程节点</Data></Cell><Cell><Data ss:Type="String">Animate</Data></Cell><Cell><Data ss:Type="String">按姿态序列播放动画</Data></Cell><Cell><Data ss:Type="String">Floor</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row><Row><Cell><Data ss:Type="String">基础动作/动画定义</Data></Cell><Cell><Data ss:Type="String">FaceFromTop</Data></Cell><Cell><Data ss:Type="String">FaceFromTop</Data></Cell><Cell><Data ss:Type="String">动作/流程节点</Data></Cell><Cell><Data ss:Type="String">Sequence</Data></Cell><Cell><Data ss:Type="String"