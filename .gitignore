# 上游项目 N.E.K.O（独立仓库，未纳入本仓库）
/N.E.K.O/
# IDEA 客户端打包暂存目录（任务结束应清理，不入库）
Project-IDEA/IDEA Assistant.staging/
# 客户端内嵌 RAG 运行时产物（2.5GB+，部署时由 fetch_wheels.py 等脚本重建，不入库）
Project-IDEA/IDEA Assistant/resources/neko/
Project-IDEA/IDEA Assistant SRH/resources/neko/
# 客户端内嵌 RAG 运行时（模型权重与 wheel 缓存，体积大且可重建，不入库）
Project-IDEA/IDEA Assistant/resources/rag/
Project-IDEA/IDEA Assistant SRH/resources/rag/
# 前端构建产物（可重新构建，不入库）
Project-IDEA/IDEA Assistant Code/dist-assistant/
Project-IDEA/IDEA Assistant Code/dist-owner/
# 雨课堂自动化工具的本地工作区（含浏览器缓存与虚拟环境，体积大，不入库）
.pw-rainclass/
# 竞赛与外部资料目录（非项目内容，不入库）
/docs/

# Shared local runtimes and caches; preserve reproducible manifests.
/Environments/*
!/Environments/Node/
/Environments/Node/*
!/Environments/Node/package.json
!/Environments/Node/package-lock.json
!/Environments/README.md

# 本地运行时、临时工作区与备份（体积大或仅本机有效，不入库）
/.local-libs/
/.local-backup/
/game/

# OCR 运行时（虚拟环境、运行时依赖、中间图块）与模型缓存：体积大且可由脚本重建
IDEA/ocr-runtime/paddle-venv/
IDEA/ocr-runtime/runtime-paddleocr/
IDEA/ocr-runtime/p59-views/
IDEA/文风素材/**/ocr-cache/
IDEA/ocr-cache-*.png

# KUAT 客户端打包产物（release/ 由 Project-KUAT/.gitignore 忽略）
Project-KUAT/Latest/
Project-KUAT/.npm-cache/

